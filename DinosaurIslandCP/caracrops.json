            {
                "LogName": "Cara Dino Island Cooking Recipes",
                "Action": "EditData",
                "Target": "Data/CookingRecipes",
                "Entries": {

                    // item id, then the item id for ingredients + quantity. then the 1 1 part is unused data but something needs to be there for it to parse so I just use 1 1. Then the name of the dish, then any unlock conditions. 
                    "{{ModId}}_FernSalad": " {{ModId}}_FernLeaf 2 {{ModId}}_DinoShroom 1/1 1/{{ModId}}_FernSalad/default",
                    "{{ModId}}_StuffedDinoShroom": " (O)247 1 {{ModId}}_DinoShroom 1 {{ModId}}_CleanedWaterChestnut 1/1 1/{{ModId}}_StuffedDinoShroom/default",
                    "{{ModId}}_GrilledDinoShroom": " (O)382 1 {{ModId}}_DinoShroom 1/1 1/{{ModId}}_GrilledDinoShroom/default",
                    "{{ModId}}_AncientVeggieSkewers": " (O)388 1 {{ModId}}_DinoShroom 1 {{ModId}}_SlicedWaterChestnut 1/1 1/{{ModId}}_AncientVeggieSkewers/default",
                    "{{ModId}}_CreamyFernSoup": " (O)245 1 (O)184 1 {{ModId}}_FernLeaf 1 {{ModId}}_ToastedWaterChestnut 1/1 1/{{ModId}}_CreamyFernSoup/default",
                    "{{ModId}}_CleanedWaterChestnut": " {{ModId}}_WaterChestnut 1/1 1/{{ModId}}_CleanedWaterChestnut/default",
                    "{{ModId}}_WaterChestnutSlices": " {{ModId}}_CleanedWaterChestnut 2/1 1/{{ModId}}_WaterChestnutSlices/default",
                    "{{ModId}}_ToastedWaterChestnut": "(O)382 1 {{ModId}}_WaterChestnutSlices 1/1 1/{{ModId}}_ToastedWaterChestnut/default",
                    "{{ModId}}_FriedWaterChestnut": "(O)247 1 (O)216 1 {{ModId}}_WaterChestnutSlices 1/1 1/{{ModId}}_FriedWaterChestnut/default",
