{
    "Changes": [
        // this part says where to get the assets to create the 'texture' that gets called for later.
        {
            "LogName": "Load Object Tilesheets",
            "Action": "Load",
            "Target": "Mods/{{ModId}}/Food, Mods/{{ModId}}/Objects, Mods/{{ModId}}/Crops",
            "FromFile": "assets/sprites/{{TargetWithoutPath}}.png"
        },
        // crop data is assigned to the seeds 
        {
            "LogName": "Cara Dino Island Crops",
            "Action": "EditData",
            "Target": "Data/Crops",
            "Entries": {
                "{{ModId}}_FernSeeds": {
                    "Seasons": [
                        "spring",
                        "summer",
                        "fall",
                        "winter"
                    ],
                    "DaysInPhase": [
                        1,
                        1,
                        2,
                        2,
                        1
                    ], // first two seed sprites are shown for one day each, stage one gets 2 days, stage two gets two days, and then the next stage gets one before it is fully grown
                    "RegrowDays": 2, // if the fern is a re-harvestable plant - how many days before it is ready again
                    "HarvestMinStack": 1,
                    "HarvestMaxStack": 1,
                    "HarvestMaxIncreasePerFarmingLevel": 0.2,
                    "ExtraHarvestChance": 0.05,
                    "HarvestItemId": "{{ModId}}_FernLeaf",
                    "Texture": "Mods/{{ModId}}/Crops",
                    "SpriteIndex": 0
                },
                "{{ModId}}_WaterChestnutSeeds": {
                    "Seasons": [
                        "Spring", "summer", "fall", "winter"
                    ],
                    "DaysInPhase": [
                        1,
                        2,
                        2,
                        3
                    ],
                    "RegrowDays": -1, // no regrowing for you
                    "IsPaddyCrop": true, // this is what says it is a water crop!
                    "HarvestMinStack": 1,
                    "HarvestMaxStack": 1,
                    "HarvestMaxIncreasePerFarmingLevel": 0.2,
                    "ExtraHarvestChance": 0.05,
                    "HarvestItemId": "{{ModId}}_WaterChestnut",
                    "Texture": "Mods/{{ModId}}/Crops",
                    "SpriteIndex": 1
                }
            }
            },
