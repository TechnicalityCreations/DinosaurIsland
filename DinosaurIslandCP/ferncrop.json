{
    "Changes": [
        // this part says where to get the assets to create the 'texture' that gets called for later.
        {
            "LogName": "Load Object Tilesheets",
            "Action": "Load",
            "Target": "Mods/{{ModId}}/Food, Mods/{{ModId}}/Objects, Mods/{{ModId}}/Crops",
            "FromFile": "assets/sprites/{{TargetWithoutPath}}.png"
        },
        // crop data is assigned to the seeds 
        {
            "LogName": "Cara Dino Island Crops",
            "Action": "EditData",
            "Target": "Data/Crops",
            "Entries": {
                "{{ModId}}_FernSeeds": {
                    "Seasons": [
                        "spring",
                        "summer",
                        "fall",
                        "winter"
                    ],
                    "DaysInPhase": [
                        1,
                        1,
                        2,
                        2,
                        1
                    ], // first two seed sprites are shown for one day each, stage one gets 2 days, stage two gets two days, and then the next stage gets one before it is fully grown
                    "RegrowDays": 2, // if the fern is a re-harvestable plant - how many days before it is ready again
                    "HarvestMinStack": 1,
                    "HarvestMaxStack": 1,
                    "HarvestMaxIncreasePerFarmingLevel": 0.2,
                    "ExtraHarvestChance": 0.05,
                    "HarvestItemId": "{{ModId}}_FernLeaf",
                    "Texture": "Mods/{{ModId}}/Crops",
                    "SpriteIndex": 0
                }
            }
        },
        //this adds object data for the seed packet, the mushrooms, and the fern item you harvest from the fern plant
        {
            "LogName": "Add Cara Dino Island Objects",
            "Action": "EditData",
            "Target": "Data/Objects",
            "Entries": {
                "{{ModId}}_FernSeeds": {
                    "Name": "{{ModId}}_FernSeeds", //internal id stuff
                    "Displayname": "Fern Seeds", //player facing
                    "Description": "Plant to grow Ferns", //player facing description
                    "Edibility": -300, //negative means cannot eat
                    "Type": "Seeds", //speficic category 
                    "Category": "-74",
                    "Price": 180, // money you get for it
                    "IsDrink": false, //can you drink it?
                    "Texture": "Mods\\{{ModId}}\\Objects",
                    "SpriteIndex": 2
                },
                "{{ModId}}_BabyBelloShroom": {
                    "Name": "{{ModId}}_BabyBelloShroom",
                    "Displayname": "Baby Bello Shroom",
                    "Description": "Baby Portobello Mushroom",
                    "Edibility": 80,
                    "Type": "Cooking",
                    "Category": -24,
                    "Price": 80,
                    "IsDrink": false,
                    "Texture": "Mods\\{{ModId}}\\Objects",
                    "SpriteIndex": 0
                },  
                "{{ModId}}_DinoShroom": {
                    "Name": "{{ModId}}_DinoShroom",
                    "Displayname": "Dino Shroom",
                    "Description": "I am dino here me roar!",
                    "Edibility": 100,
                    "Type": "Cooking",
                    "Category": -24,
                    "Price": 80,
                    "IsDrink": false,
                    "Texture": "Mods\\{{ModId}}\\Objects",
                    "SpriteIndex": 1
            },
            "{{ModId}}_FernLeaf": {
                "Name": "{{ModId}}_FernLeaf",
                "Displayname": "Fern Leaf",
                "Edibility": 100,
                "Type": "Cooking",
                "Category": "-24",
                "Price": 120,
                "IsDrink": false,
                "Texture":"Mods\\{{ModId}}\\Objects",
                "SpriteIndex": 3
            }
        }
        },
        //adds the cooked dishes as items (this could be added to the above entry but I find it helpful to have them separate)
        {
            "LogName": "Add Food",
            "Action": "EditData",
            "Target": "Data/Objects",
            "Entries": {
                "{{ModId}}_FernSalad": {
                    "Name": "{{ModId}}_FernSalad",
                    "DisplayName": "Fern Salad",
                    "Description": "Bare bones, but yummy!",
                    "Edibility": "69",
                    "Type": "Cooking",
                    "Category": -7,
                    "Price": 220,
                    "IsDrink": false,
                    "Texture": "Mods\\{{ModId}}\\Food",
                    "SpriteIndex": 0
                },
                "{{ModId}}_StuffedDinoShroom": {
                    "Name": "{{ModId}}_StuffedDinoShroom",
                    "Displayname": "Stuffed Dino Shroom",
                    "Description": "Shroom cap stuffed with breaded filling",
                    "Edibility": 200,
                    "Type": "Cooking",
                    "Category": -7,
                    "Price": 280,
                    "IsDrink": false,
                    "Texture":"Mods\\{{ModId}}\\Food",
                    "SpriteIndex": 1
                },
                 "{{ModId}}_GrilledDinoShroom": {
                    "Name": "{{ModId}}_GrilledDinoShroom",
                    "Displayname": "Grilled Dino Shroom",
                    "Description": "Just add fire!",
                    "Edibility": 160,
                    "Type": "Cooking",
                    "Category": -7,
                    "Price": 180,
                    "IsDrink": false,
                    "Texture":"Mods\\{{ModId}}\\Food",
                    "SpriteIndex": 2
                 }
                }
            }
            ]
        }